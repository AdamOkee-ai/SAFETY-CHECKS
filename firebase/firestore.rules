rules_version = '2';
// Site Safety Checks: Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Owner emails (lower case) go in owner() below. The live copy in the Firebase console holds the real address; this public copy keeps a placeholder.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email != null && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function owner() { return verified() && email() in ['you@example.com']; }
    function supervisor() {
      return owner() || (verified()
        && exists(/databases/$(database)/documents/members/$(email()))
        && get(/databases/$(database)/documents/members/$(email())).data.role == 'supervisor');
    }
    function str(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }

    // Site details and the SharePoint upload link: everyone reads, supervisors change.
    match /config/{id} { allow read: if signedIn(); allow write: if supervisor(); }

    // Supervisor list.
    match /members/{id} { allow read: if supervisor() || (verified() && email() == id); allow write: if supervisor(); }

    // Site list. Staff can add themselves (flagged for the supervisor to check) but not change anyone.
    match /people/{id} {
      allow read: if signedIn();
      allow create: if supervisor() || (signedIn()
        && request.resource.data.keys().hasOnly(['name', 'company', 'harness', 'active', 'selfAdded', 'at'])
        && str(request.resource.data.name, 3, 80) && str(request.resource.data.company, 1, 80)
        && request.resource.data.selfAdded == true && request.resource.data.active == true);
      allow update, delete: if supervisor();
    }
    match /mewps/{id} {
      allow read: if signedIn();
      allow create: if supervisor() || (signedIn()
        && request.resource.data.keys().hasOnly(['label', 'active', 'selfAdded', 'at'])
        && str(request.resource.data.label, 3, 120) && request.resource.data.selfAdded == true && request.resource.data.active == true);
      allow update, delete: if supervisor();
    }

    // Submitted reports: anyone on the app can submit; only supervisors can read them.
    match /submissions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['mewp', 'harness'] && str(request.resource.data.date, 10, 10);
      allow update: if supervisor() || (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uploaded']));
      allow read, delete: if supervisor();
    }
    match /pdfs/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && str(request.resource.data.data, 1, 200000);
      allow read, delete: if supervisor();
    }

    // "Not on site", "Not in use" and "Site closed" marks.
    match /excused/{id} { allow read, write: if supervisor(); }
  }
}
